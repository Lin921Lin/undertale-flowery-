        }
      ]
    },
    "notepad": {
      "displayName": "记事本 / 备忘",
      "description": "用户打开/写入记事本（桌宠内置或系统备忘录）时触发。他嫉妒你写给别人/别的事，却从不写他；偶尔漏一句 mask。",
