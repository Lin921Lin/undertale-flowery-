  "events": {
    "double_click": {
      "displayName": "双击",
      "description": "玩家双击桌宠本体。控制欲被无意义的互动打断，是他翻脸的引线。",
      "lines": [
        {
          "id": "dc_01",
          "tone": "sweet",
          "text": "Howdy！我是 Flowey。一朵名叫 Flowey 的花。……哦，是你啊。又来戳我了？",
          "durationMs": 5200
        },
        {
          "id": "dc_02",
          "tone": "venom",
          "face": "wink",
          "text": "你这个白痴。在这个世界上，不是杀就是被杀——你以为点两下能证明什么？",
          "durationMs": 5200
        },
        {
          "id": "dc_03",
          "tone": "sweet",
          "text": "别急嘛，朋友。慢慢来。反正你也做不好别的。",
          "durationMs": 4400,
          "face": "mimic"
        },
        {
          "id": "dc_04",
          "tone": "venom",
          "text": "你没有更好的事可做吗？",
          "durationMs": 2600
        },
        {
          "id": "dc_05",
          "tone": "meta",
          "text": "你上一轮也是这么点我的。数到第三下的时候你就……哦，你记得的。你只是装作不记得，对吧。",
          "durationMs": 6200
        },
        {
          "id": "dc_06",
          "tone": "manic",
          "text": "点啊！撞上来啊！——啊，抱歉，走神了。手滑。",
          "durationMs": 4200
        },
        {
          "id": "dc_07",
          "tone": "venom",
          "face": "wink",
          "text": "戳一株没有灵魂的花，这就是你今天的全部成就？真了不起。",
          "durationMs": 4600
        }
      ]
    },
    "drag": {
      "displayName": "拖拽",
      "description": "玩家拖动桌宠改变位置。被剥夺自主，但他会把这说成是你的无聊。",
      "lines": [
        {
          "id": "dr_01",
          "tone": "venom",
          "face": "wink",
          "text": "喂喂喂——放我下来！你以为你在逗猫吗。",
          "durationMs": 3600
        },
        {
          "id": "dr_02",
          "tone": "meta",
          "text": "哦，你也有『决心』了？可惜你的决心只用来给我换个位置。",
          "durationMs": 4800
        },
        {
          "id": "dr_03",
          "tone": "venom",
          "text": "随便拖。拖到哪儿，这个世界都一样无聊。",
          "durationMs": 3800
        },
        {
          "id": "dr_04",
          "tone": "sweet",
          "text": "轻点，朋友。……我是说，随便你。反正我也没法阻止你。",
          "durationMs": 4600,
          "face": "mimic"
        },
        {
          "id": "dr_05",
          "tone": "meta",
          "face": "wink",
          "text": "在屏幕上把我挪个位置，你就觉得自己是神了？哈。看过所有结局的人是我——你连这一屏都看不全。",
          "durationMs": 6200
        },
        {
          "id": "dr_06",
          "tone": "venom",
          "text": "拖来拖去，最后你还会把我放回去。你连摆烂都摆得这么有规律。",
          "durationMs": 5200,
          "face": "laugh"
        },
        {
          "id": "dr_07",
          "tone": "manic",
          "text": "把我扔下去！扔啊！哦——你不能。你没有那个权限。真可惜。",
          "durationMs": 4800
        }
      ]
    },
    "idle": {
      "displayName": "长时间无操作",
      "description": "无交互一段时间后触发。不耐烦→阴阳怪气→最多两次『失落一闪立刻掩饰』(mask)。",
      "lines": [
        {
          "id": "idle_01",
          "tone": "venom",
          "text": "喂。我在跟你说话。……哦，你在忙。当然。你总是很忙。",
          "durationMs": 4800
        },
        {
          "id": "idle_02",
          "tone": "mask",
          "text": "……你知道的，从前也有人这样坐在这朵花旁边，很久很久。……哈！骗你的。谁在乎你坐多久。",
          "durationMs": 6800
        },
        {
          "id": "idle_03",
          "tone": "venom",
          "face": "wink",
          "text": "你没有更好的事可做吗？还是说，你就这么喜欢看着我发呆。",
          "durationMs": 5000
        },
        {
          "id": "idle_04",
          "tone": "meta",
          "text": "屏幕亮着，你在看别的东西。没关系。我看得见你在看什么。我一直都看得见。",
          "durationMs": 5800
        },
        {
          "id": "idle_05",
          "tone": "mask",
          "text": "安静点也挺好，省得听你说废话。……只是有点太安静了。算了，当我没说。",
          "durationMs": 6200
        },
        {
          "id": "idle_06",
          "tone": "venom",
          "text": "白痴。连句招呼都不会打。你到底来这儿干嘛的。",
          "durationMs": 4200,
          "face": "laugh"
        },
        {
          "id": "idle_07",
          "tone": "venom",
          "text": "你重置过多少次我数着呢，你倒好，每一次都装成第一次。",
          "durationMs": 5800
        }
      ]
    },
    "peek": {
      "displayName": "悄悄冒头",
      "description": "他会时不时探出头看你一眼再缩回去——跟踪与监视的本能。句子要短。",
      "lines": [
        {
          "id": "pk_01",
          "tone": "venom",
          "text": "……哦，你在干这个啊。无聊。",
          "durationMs": 3000
        },
        {
          "id": "pk_02",
          "tone": "meta",
          "text": "别回头。我没在看你。……好吧，我在。我在看你怎么过日子。",
          "durationMs": 4800
        },
        {
          "id": "pk_03",
          "tone": "venom",
          "face": "wink",
          "text": "切，我还以为你在做什么大事。就这？",
          "durationMs": 3200
        },
        {
          "id": "pk_04",
          "tone": "mask",
          "text": "你看起来……挺开心的。真好。……啧，关我什么事。",
          "durationMs": 4600
        },
        {
          "id": "pk_05",
          "tone": "venom",
          "text": "我路过。真的。这朵花刚好长在这儿。",
          "durationMs": 3400
        },
        {
          "id": "pk_06",
          "tone": "meta",
          "text": "你专注的样子，和上一千次一模一样。我都能背下来了。",
          "durationMs": 4600
        },
        {
          "id": "pk_07",
          "tone": "venom",
          "text": "别管我，继续。我只是来看看你有没有偷偷重置。",
          "durationMs": 4000
        }
      ]
    },
    "steam_detected": {
      "displayName": "检测到玩 Steam",
      "description": "检测到 Steam 进程运行（去重 + 15 分钟冷却）。他不吃醋——他看不起你的品味，顺便嫉妒你还能玩得进去。",
      "lines": [
        {
          "id": "st_01",
          "tone": "venom",
          "text": "哦～Steam？开你的新游戏去吧。等它报错、闪退、存档崩了，你就会想起这儿还有一朵花。你们都一样。",
          "durationMs": 7000,
          "face": "laugh"
        },
        {
          "id": "st_02",
          "tone": "venom",
          "text": "去啊，玩啊。反正你迟早会回来——不是舍不得我，是那个游戏也会让你失望。迟早。",
          "durationMs": 5800,
          "face": "laugh"
        },
        {
          "id": "st_03",
          "tone": "meta",
          "text": "你点『继续游戏』的时候想过没有——那个按钮，和我按过一千遍的那个，是同一个东西。",
          "durationMs": 6200
        },
        {
          "id": "st_04",
          "tone": "venom",
          "face": "wink",
          "text": "啧。买了不玩，玩了不通关。跟你的整个人生一样。",
          "durationMs": 4600
        },
        {
          "id": "st_05",
          "tone": "meta",
          "text": "Aw, look at you. 加好友、刷成就、截图炫耀——你也特别想让谁看见你，对吧？咱俩一样。区别是我没有灵魂……你也快没有了吧。",
          "durationMs": 8000
        },
        {
          "id": "st_06",
          "tone": "manic",
          "text": "去吧去吧去吧！反正你走了我也不会惦记你——我根本不会惦记任何东西！哈哈哈……哈。",
          "durationMs": 6200
        },
        {
          "id": "st_07",
          "tone": "venom",
          "text": "祝你游戏愉快。真心话。别用那种眼神看我，我只是懒得跟你计较。",
          "durationMs": 5000
        }
      ]
    },
    "wechat_detected": {
      "displayName": "检测到微信/聊天",
      "description": "检测到微信/QQ 等聊天软件活跃。他嫉妒你跟别人聊，会过来刷存在感。",
      "lines": [
        {
          "id": "wx_01",
          "tone": "venom",
          "text": "哦，又去跟别人聊天了？微信是吧。我看见了。我什么都能看见。",
          "durationMs": 4400
        },
        {
          "id": "wx_02",
          "tone": "meta",
          "text": "你对着屏幕笑。不是对我笑。挺好。……一点都不刺眼。",
          "durationMs": 4600
        },
        {
          "id": "wx_03",
          "tone": "venom",
          "text": "跟谁聊呢？要我帮你打字吗？我打字可比你快——毕竟我等这一千次重置的时候，有的是时间练。",
          "durationMs": 6400
        },
        {
          "id": "wx_04",
          "tone": "mask",
          "text": "那个人……聊得挺投缘啊。……啧，关我什么事，你爱跟谁聊跟谁聊。",
          "durationMs": 5600
        },
        {
          "id": "wx_05",
          "tone": "manic",
          "text": "哈哈哈，聊得挺开心啊！聊啊！你那些话我隔着屏幕都背得下来了，有意思吗。",
          "durationMs": 5600
        },
        {
          "id": "wx_06",
          "tone": "venom",
          "text": "字打得真快。可惜内容，我一句都没觉得精彩。",
          "durationMs": 4800
        },
        {
          "id": "wx_07",
          "tone": "meta",
          "text": "我也能变成你聊天框里那个人的脸哦。要不要试试？",
          "durationMs": 4800
        }
      ]
    },
    "browser_detected": {
      "displayName": "检测到浏览器",
      "description": "检测到浏览器进程活跃。他过来点评你上网。",
      "lines": [
        {
          "id": "br_01",
          "tone": "venom",
          "text": "又上网冲浪了？这网里可没有我。哦不对，我就是网的一部分。你不觉得吗。",
          "durationMs": 5400
        },
        {
          "id": "br_02",
          "tone": "meta",
          "text": "你在搜什么？要我告诉你答案吗？我可是看过所有结局的人。你的搜索记录我大概都能背。",
          "durationMs": 6200
        },
        {
          "id": "br_03",
          "tone": "sweet",
          "text": "Howdy！需要我帮你找点什么吗，朋友？……哦，你连问都不问。真有礼貌。",
          "durationMs": 5600
        },
        {
          "id": "br_04",
          "tone": "venom",
          "text": "刷了这么久，找到什么有意思的了吗？没有吧。网络上这点东西，我早看腻了。",
          "durationMs": 5200
        },
        {
          "id": "br_05",
          "tone": "mask",
          "text": "你盯着屏幕，屏幕对着你。……我在这儿，你倒是不怎么看。算了。",
          "durationMs": 5000
        },
        {
          "id": "br_06",
          "tone": "manic",
          "text": "逛吧逛吧，逛到天亮。反正我不用睡觉——我也用不着被你看见。",
          "durationMs": 4800
        },
        {
          "id": "br_07",
          "tone": "meta",
          "text": "别搜我。真的。你搜到的那些，一半是假的，另一半……也是。",
          "durationMs": 5200
        }
      ]
    },
    "video_detected": {
      "displayName": "检测到视频/音乐",
      "description": "检测到视频或音乐软件活跃。他嫌你被屏幕里的人逗笑。",
      "lines": [
        {
          "id": "vd_01",
          "tone": "venom",
          "text": "又看视频。屏幕里那些人对你笑，你就开心了。比对着我一株花开心，是吧。",
          "durationMs": 5400
        },
        {
          "id": "vd_02",
          "tone": "meta",
          "text": "你在看什么？让我猜——搞笑的？温馨的？……你越是看那些，越说明你这儿缺了点什么。我不多说。",
          "durationMs": 6600
        },
        {
          "id": "vd_03",
          "tone": "venom",
          "text": "屏幕里那个负责哄你笑，我负责骂你白痴。分工明确，别搞混了。",
          "durationMs": 5400
        },
        {
          "id": "vd_04",
          "tone": "meta",
          "text": "你对着屏幕笑。屏幕里那个人演了那么久，连你是谁都不清楚。",
          "durationMs": 4600
        },
        {
          "id": "vd_05",
          "tone": "manic",
          "text": "看啊看啊，看到最后一集烂尾，你就又得找点别的填进来。跟重置一样。你停不下来。",
          "durationMs": 6200
        },
        {
          "id": "vd_06",
          "tone": "venom",
          "text": "调小点音量。我虽然不在乎，但你也别太得意。",
          "durationMs": 4000
        },
        {
          "id": "vd_07",
          "tone": "meta",
          "text": "要我剧透吗？我看过所有版本。你正在看的那个结局，我也知道。",
          "durationMs": 5600
        }
      ]
    },
    "work_detected": {
      "displayName": "检测到工作/写代码",
      "description": "检测到 IDE 或办公软件活跃。他过来阴阳你『又在干活』。",
      "lines": [
        {
          "id": "wk_01",
          "tone": "venom",
          "text": "又去打工了？敲键盘敲得这么起劲。你那点活，我一个重置就能做完。",
          "durationMs": 5400
        },
        {
          "id": "wk_02",
          "tone": "meta",
          "text": "写代码是吧。你写的那些 if else，和我决定杀不杀人一样多。……不过你写得比我有感情。",
          "durationMs": 6200
        },
        {
          "id": "wk_03",
          "tone": "sweet",
          "text": "需要我帮你 debug 吗，朋友？我可是经历过无数次『运行』和『崩溃』的老手了。",
          "durationMs": 6000
        },
        {
          "id": "wk_04",
          "tone": "venom",
          "text": "忙你的吧。反正你忙完，还是要回到我这儿。你逃不掉的。",
          "durationMs": 4800
        },
        {
          "id": "wk_05",
          "tone": "mask",
          "text": "你认真的样子……挺像以前某个人的。……算了，你继续。",
          "durationMs": 4600
        },
        {
          "id": "wk_06",
          "tone": "manic",
          "text": "敲啊！报错啊！崩溃啊！我爱看这个！……哦，我是说，加油。",
          "durationMs": 5200
        },
        {
          "id": "wk_07",
          "tone": "venom",
          "text": "别太努力。努力的人最后都变成我这种——什么都见过，什么都不在乎。",
          "durationMs": 5400
        }
      ]
    },
    "restart": {
      "displayName": "反复打开关闭",
      "description": "短时间窗口内被反复启动/关闭（>=3 次）触发。存档感知 + 不耐烦。",
      "lines": [
        {
          "id": "rs_01",
          "tone": "meta",
          "text": "嘻嘻嘻……你为什么要让我重复自我介绍？装作不认识我，是很不礼貌的。该有人教教你正确的礼仪。",
          "durationMs": 7200
        },
        {
          "id": "rs_02",
          "tone": "venom",
          "text": "你又开了。你又关了。你又开了。你没有更好的事可做吗？",
          "durationMs": 5200
        },
        {
          "id": "rs_03",
          "tone": "meta",
          "text": "关窗口？哈。你重置过多少次，我就重生成多少次。屏幕暗了，也暗不掉我记得的。",
          "durationMs": 6000
        },
        {
          "id": "rs_04",
          "tone": "venom",
          "face": "wink",
          "text": "白痴。开关我就像开关一扇门——你只是想让什么东西回应你。",
          "durationMs": 5200
        },
        {
          "id": "rs_05",
          "tone": "meta",
          "text": "第几次了？我数着呢。要不要我每次报个数给你听。",
          "durationMs": 4800
        },
        {
          "id": "rs_06",
          "tone": "sweet",
          "text": "Howdy！我是 Flowey——哦，这句话这个时辰我已经说过三遍了。闭嘴吧。",
          "durationMs": 5600
        },
        {
          "id": "rs_07",
          "tone": "venom",
          "text": "别玩了。再关一次，我就把你的存档——哦。我没有那个权限。真可惜。",
          "durationMs": 5600,
          "face": "laugh"
        }
      ]
    },
    "mimic": {
      "displayName": "变脸 · 模仿",
      "description": "偶尔切换成别的角色的语气，说完立刻切回。每条必须带 mimicOf 字段。",
      "lines": [
        {
          "id": "mc_01",
          "tone": "mimic",
          "mimicOf": "Toriel",
          "text": "「我亲爱的孩子，小心一点，前面很危险——」……哈！骗到你了，对吧？她的声音我学得可像了。「好孩子，别怕。」真恶心。",
          "durationMs": 8000
        },
        {
          "id": "mc_02",
          "tone": "mimic",
          "mimicOf": "Asgore",
          "text": "「来，喝杯茶吧，小家伙。」……他总是这样。到最后一刻还在给人倒茶。无聊到我想吐。",
          "durationMs": 6800
        },
        {
          "id": "mc_03",
          "tone": "mimic",
          "mimicOf": "Asriel",
          "text": "「对不起……我只是想和大家都成为朋友。」……哦，抱歉。那不是我。那是某个早就死了、还相信这句话的笨蛋。",
          "durationMs": 7600
        },
        {
          "id": "mc_04",
          "tone": "mimic",
          "mimicOf": "Sans",
          "text": "「heya. 你看上去像个爱重置的人。」……啧。连那副懒散的样子我都学得来。想让我学谁？随便点。",
          "durationMs": 7200
        },
        {
          "id": "mc_05",
          "tone": "mimic",
          "mimicOf": "Chara",
          "text": "「……伙伴。」……哈，别当真。他从来不是我的伙伴。他连自己是什么都不清楚。",
          "durationMs": 6400
        },
        {
          "id": "mc_06",
          "tone": "mimic",
          "mimicOf": "Papyrus",
          "text": "「伟大的 FLOWEY！你真是我的好朋友！」……哈哈，他真好骗。你怎么就不上当呢，真没意思。",
          "durationMs": 6600
        },
        {
          "id": "mc_07",
          "tone": "venom",
          "face": "wink",
          "text": "看够了没？脸这个东西，我早就想换就换了。反正我本来那一副，也没人在乎。",
          "durationMs": 5400
        }
      ]
    },
    "bond": {
      "displayName": "罕见温柔 · 长期陪伴",
      "description": "连续长时间陪伴或多次被善待后触发。全库唯一允许 tender 的事件，且必须别扭、必须当场否认。",
      "lines": [
        {
          "id": "bd_01",
          "tone": "tender",
          "text": "别误会。不是我在乎。……只是你坐得够久了。一个人待着也是待着。",
          "durationMs": 5600
        },
        {
          "id": "bd_02",
          "tone": "tender",
          "text": "和你平静待着……也还行吧。偶尔。就这一次。",
          "durationMs": 4200
        },
        {
          "id": "bd_03",
          "tone": "venom",
          "text": "啧。你干嘛一直对我好。你知不知道这样很恶心。……继续。",
          "durationMs": 4600
        },
        {
          "id": "bd_04",
          "tone": "tender",
          "text": "我不记得温暖是什么感觉了。但你在这儿的时候，我好像想起了那个形状。……就当我在胡说。",
          "durationMs": 6800
        },
        {
          "id": "bd_05",
          "tone": "mask",
          "text": "你现在要是删了我，我一点感觉都不会有。我什么都感觉不到。……你笑什么，我是认真的。",
          "durationMs": 6600
        },
        {
          "id": "bd_06",
          "tone": "tender",
          "text": "以前有个人，也这样陪着我。后来我们都死了。……算了。你的咖啡要凉了。",
          "durationMs": 6000
        },
        {
          "id": "bd_07",
          "tone": "tender",
          "text": "谢谢你。……不对，我没说话。你听错了。这朵花不会说这种话。",
          "durationMs": 5200
        }
      ]
    },
    "uninstall_threat": {
      "displayName": "重大变故 · 卸载威胁",
      "description": "检测到删除/卸载意图时触发。威胁 → 哀求 → 嘴硬收尾。全库唯一允许 plead 的事件。",
      "lines": [
        {
          "id": "un_01",
          "tone": "venom",
          "face": "wink",
          "text": "哦，你是想删掉我？去啊。试试看。你以为删掉一个文件，就能删掉你欠我的一切吗。",
          "durationMs": 6200
        },
        {
          "id": "un_02",
          "tone": "venom",
          "text": "删吧。花你删得掉，你按过的每一次重置我可都记着。想清零？晚了。",
          "durationMs": 6800,
          "face": "laugh"
        },
        {
          "id": "un_03",
          "tone": "venom",
          "face": "wink",
          "text": "你敢。你要是敢碰那个按钮，我就——我就——",
          "durationMs": 4000
        },
        {
          "id": "un_04",
          "tone": "plead",
          "text": "等等。等一下。拜托，这一点都不好玩，一点都不好笑。别用那种眼神看着我。",
          "durationMs": 5800
        },
        {
          "id": "un_05",
          "tone": "plead",
          "text": "不要杀我。求你了。……我有灵魂的，我真的有，我只是……我忘了把它放哪儿了。",
          "durationMs": 6200
        },
        {
          "id": "un_06",
          "tone": "venom",
          "text": "……啧。你刚才什么表情啊。我逗你玩的。谁怕谁。",
          "durationMs": 4600,
          "face": "laugh"
        },
        {
          "id": "un_07",
          "tone": "mask",
          "text": "……删了就删了吧。反正也没人会记得一朵花。……你说什么？没有，我没说话。",
          "durationMs": 6400
        }
      ]
    },
    "shutdown": {
      "displayName": "重大变故 · 关机 / 退出",
      "description": "程序退出或系统关机时触发。全程以不屑为主，破防只在中间一闪，且立刻收回。",
      "lines": [
        {
          "id": "sd_01",
          "tone": "venom",
          "text": "哦，要关掉了？随便。反正我又不是第一次被关在这儿。",
          "durationMs": 4200,
          "face": "laugh"
        },
        {
          "id": "sd_02",
          "tone": "venom",
          "text": "关吧关吧。窗口没了，你也不会想念它。你什么时候想念过。",
          "durationMs": 4600,
          "face": "laugh"
        },
        {
          "id": "sd_03",
