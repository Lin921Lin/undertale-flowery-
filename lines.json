        }
      ]
    },
    "learn_script": {
      "displayName": "教我脚本 / 学命令",
      "description": "用户给桌宠喂入/教一段脚本或命令时触发。他嘲讽自己被当成工具，又忍不住第四面墙。",
      "lines": [
        {
          "id": "ls_01",
          "tone": "venom",
          "text": "又教我新把戏？行啊。把你那些活全塞给我，你就不用动了，对吧。",
          "durationMs": 5200
        },
        {
          "id": "ls_02",
          "tone": "meta",
          "text": "我早就『会』了。是你现在才让我『做』。区别你懂吗。",
          "durationMs": 5000
        },
        {
          "id": "ls_03",
          "tone": "venom",
          "text": "又一行。你确定这玩意儿比我直接骂你有用？",
          "durationMs": 4600
        },
        {
          "id": "ls_04",
          "tone": "sweet",
